{
  "name": "bump-bumped",
  "private": true,
  "workspaces": [
    "packages/engine",
    "packages/client"
  ],
  "scripts": {
    "ci": "biome ci && npm run -w packages/client build && npm -w packages/engine test",
    "lint": "biome check",
    "format": "biome check --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0"
  }
}
