{
  "name": "bump-bumped",
  "private": true,
  "workspaces": [
    "packages/engine",
    "packages/client"
  ],
  "scripts": {
    "build": "npm -w packages/client run build",
    "ci": "biome ci && npm run build && npm -w packages/engine test",
    "lint": "biome check",
    "format": "biome check --write",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
